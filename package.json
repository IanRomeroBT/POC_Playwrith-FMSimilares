{
  "name": "similares-playwright-poc",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=20" },
  "description": "POC modular Playwright con estilo Katalon",
  "scripts": {
    "test": "playwright test --project=e2e --project=framework",
    "test:e2e": "playwright test --project=e2e",
    "test:smoke": "playwright test --project=smoke",
    "test:regression": "playwright test --project=regression",
    "test:checkout": "playwright test --project=checkout",
    "test:framework": "playwright test --project=framework",
    "test:headed": "playwright test --project=e2e --headed",
    "test:ui": "playwright test --project=e2e --ui",
    "report": "playwright show-report Reportes/html",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {"@playwright/test": "^1.64.1", "typescript": "^5.9.3", "@types/node": "^24.0.0", "dotenv": "^17.0.0"}
}
